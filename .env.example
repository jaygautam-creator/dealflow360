# Postgres connection string.
# Local:  postgresql://USER:PASSWORD@localhost:5432/dealflow360
# Hosted: the pooled connection string from your Postgres provider
DATABASE_URL="postgresql://user:password@host/dealflow360?sslmode=require"

# Secret used to sign session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
