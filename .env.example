# Local PostgreSQL. Create the database once with:
#   createdb dealflow360
# The default below assumes Postgres is running as your own user, which is what
# `brew install postgresql@16` gives you on macOS.
DATABASE_URL="postgresql://YOUR_USER@localhost:5432/dealflow360?schema=public"

# Prisma Migrate uses a direct (unpooled) connection. Locally these are the same.
DATABASE_URL_UNPOOLED="postgresql://YOUR_USER@localhost:5432/dealflow360?schema=public"

# Signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
